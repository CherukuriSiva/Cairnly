# Public build settings for production builds (`next build`). Every NEXT_PUBLIC_ value is
# shipped to the browser, so this file holds public values only: never a key or a password.
# A variable set in the Vercel dashboard overrides the value here.

# The voice server (deploy/modal_voice.py). Remove it, or set it to empty in Vercel, to hide the mic.
NEXT_PUBLIC_VOICE_URL=https://cherukurisiva--cairnly-voice-web.us-east.modal.run
