# Copy to .env. Defaults work for the local Docker Compose + Ollama setup.

DATABASE_URL=postgresql://cairnly:cairnly@localhost:5434/cairnly
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Which LLM answers. "ollama" is the default, locally and in production (on a Modal GPU).
LLM_PROVIDER=ollama
OLLAMA_CHAT_MODEL=qwen3:8b

# The Claude API is for local development only. To try it, set ALLOW_ANTHROPIC=true here and
# keep the Anthropic key in your own shell environment: never in this file, the repo or any
# deploy config. A server with CAIRNLY_ENV=production refuses to start with ALLOW_ANTHROPIC on.
ALLOW_ANTHROPIC=false
ANTHROPIC_MODEL=claude-opus-5-5
# Any value other than development or test counts as production.
CAIRNLY_ENV=development

# Ollama on Modal (production): the proxy-auth token the API sends with every model call.
# Leave empty for a local Ollama.
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

# How many chunks the answer prompt gets. Confidence gates are per knowledge base (kbs.yaml).
TOP_K=6

# Abuse limits (per API process). Rate limits count /ask and /search per client IP.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=200
GLOBAL_ANSWERS_PER_DAY=2000
MAX_CONCURRENT_ANSWERS=4
# Wall-clock seconds to wait for the first token (covers a cold GPU) and then for the rest of
# the answer. A follow-up's rewrite gets FIRST_TOKEN_TIMEOUT_S in total.
FIRST_TOKEN_TIMEOUT_S=90
ANSWER_TIMEOUT_S=60
# Saved conversations (questions, answers and votes in Postgres; PRIVACY.md). 0 turns them off:
# the chat then keeps its history in the tab. Idle conversations are deleted after the retention.
CONVERSATIONS=1
CONVERSATION_RETENTION_DAYS=30
# Per client IP, the conversation and vote routes (separate from the /ask and /search limits),
# and new conversations per day for the whole site.
STORE_RATE_LIMIT_PER_MINUTE=30
STORE_RATE_LIMIT_PER_DAY=1000
CONVERSATIONS_PER_DAY=5000
# 1 only behind one trusted proxy (the load balancer): the client IP is then the last
# X-Forwarded-For entry. Leave 0 when the API is reached directly.
TRUST_PROXY=0
# Browser origins allowed to call the API (comma-separated). Same-origin production needs none.
CORS_ORIGINS=http://localhost:3010

# Tracing (optional). Leave empty to disable. For the local Langfuse in
# compose.observability.yaml use the dev defaults below; for Langfuse Cloud use your keys and
# LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_HOST=http://localhost:3011
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Traces hold no question or answer text unless this is 1 (local debugging only).
TRACE_CONTENT=0

# Voice mode (optional; `uv sync --extra voice --extra voice-models`, then
# `uv run cairnly voice-serve`, port 8020). The web app shows the microphone only when it is
# built with NEXT_PUBLIC_VOICE_URL (e.g. http://localhost:8020) and the API saves conversations;
# it asks this server nothing until the mic is clicked.
# The voice server reuses CORS_ORIGINS and TRUST_PROXY from above.
VOICE_ENABLED=1
VOICE_API_URL=http://localhost:8010
# websocket (production) and/or webrtc (peer to peer, local); the first is the default.
VOICE_TRANSPORTS=websocket,webrtc
VOICE_STUN_URLS=stun:stun.l.google.com:19302
# A call lasts at most VOICE_MAX_CALL_S, warns VOICE_ENDING_NOTICE_S before the end and hangs
# up after VOICE_IDLE_S without speech. 1 makes the bot impossible to interrupt (half duplex).
VOICE_MAX_CALL_S=300
VOICE_ENDING_NOTICE_S=30
VOICE_IDLE_S=50
VOICE_HALF_DUPLEX=0
# Budgets per UTC day (in memory, per voice server process).
VOICE_MAX_CALLS=1
VOICE_CALLS_PER_IP_PER_DAY=10
VOICE_STARTS_PER_IP_PER_MINUTE=5
VOICE_MINUTES_PER_DAY=60
# Speech models: Whisper large-v3-turbo on the CPU (int8) locally, cuda/float16 on a GPU.
VOICE_STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
VOICE_STT_DEVICE=cpu
VOICE_STT_COMPUTE=int8
VOICE_STT_THREADS=0
VOICE_TTS_VOICE=af_heart
# 1: no models at all (scripted speech and a tone), for working on the page.
VOICE_FAKE_MODELS=0
