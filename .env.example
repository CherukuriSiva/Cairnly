# Copy to .env. Defaults work for the local Docker Compose + Ollama setup.

DATABASE_URL=postgresql://cairnly:cairnly@localhost:5434/cairnly
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Which LLM answers: "ollama" (free, local) or "anthropic" (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=ollama
OLLAMA_CHAT_MODEL=qwen3:8b
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Confidence gate: if the best match's cosine similarity is below this, refuse instead of guessing
MIN_SCORE=0.55
TOP_K=6
