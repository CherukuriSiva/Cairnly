# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Secrets: copy .env.example to .env and fill it in
.env

# Editors
.idea/
.vscode/
.DS_Store

# Web
web/node_modules/
web/.next/

# Vercel CLI project link (created by `vercel link`)
.vercel/

# Local datasets, never committed
data/

# Reference books and other PDFs in the repo root, never committed
/*.pdf

# eval reports (re-generated on every run)
evals/last-*.json

# Terraform (keep .terraform.lock.hcl: it pins provider versions)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Personal drafts (LinkedIn posts etc.), never published with the repo
drafts/

# Claude Code session records (local tooling, never published)
awesome-artifacts/
awesome-artifacts.private/
